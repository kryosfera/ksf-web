---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; updated: string }
const { title, description, updated } = Astro.props;
---
<BaseLayout title={`${title} · KSF Digital Healthcare`} description={description} mode="claro">
  <article class="wrap legal">
    <h1>{title}</h1>
    <p class="upd">Última actualización: {updated}</p>
    <slot />
  </article>
</BaseLayout>
<style>
  .legal { max-width: 820px; padding-block: 72px 110px; }
  h1 { font-size: clamp(36px, 4.4vw, 60px); font-weight: 900; }
  .upd { color: var(--muted); font-size: 14px; margin: 10px 0 36px; }
  .legal :global(h2) { font-size: 22px; margin: 32px 0 10px; }
  .legal :global(p), .legal :global(li) { color: var(--fg); opacity: .9; margin-bottom: 12px; }
  .legal :global(p a) { text-decoration: underline; text-underline-offset: 3px; }
</style>
