---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; mode: 'oscuro' | 'claro'; overlayHeader?: boolean; jsonLd?: object; noindex?: boolean }
const { title, description, mode, overlayHeader = false, jsonLd, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="es" data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} jsonLd={jsonLd} noindex={noindex} />
    <ClientRouter />
  </head>
  <body>
    <a class="sr-only" href="#contenido">Saltar al contenido</a>
    <Header overlay={overlayHeader} />
    <main id="contenido"><slot /></main>
    <Footer />
    <script>import '../scripts/motion';</script>
  </body>
</html>
