---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformCard from '../components/PlatformCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
const plataformas = (await getCollection('plataformas')).map((p) => p.data);
---
<BaseLayout title="Plataformas digitales · KSF Digital Healthcare" description="Portal de formación Inginium, casos clínicos virtuales, juegos de gamificación clínica, asistente de IA para eventos y recetario digital." mode="claro">
  <section class="wrap head">
    <span class="eyebrow">Plataformas KSF</span>
    <h1 data-split>Plataformas digitales</h1>
    <p class="lead">Productos digitales propios para formación, congresos y relación con el profesional sanitario. Accede directamente o pídenos una demo.</p>
  </section>
  <section class="wrap cards">{plataformas.map((p) => <PlatformCard p={p} />)}</section>
  <ContactCTA servicio="interactivos" />
</BaseLayout>
<style>
  .head { padding-block: 72px 32px; display: grid; gap: 14px; }
  h1 { font-size: clamp(40px, 5.6vw, 84px); font-weight: 900; }
  .lead { color: var(--muted); max-width: 60ch; font-size: 19px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; padding-bottom: 96px; }
</style>
