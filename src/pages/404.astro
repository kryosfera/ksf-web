---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada · KSF Digital Healthcare" description="La página que buscas no existe." mode="claro">
  <section class="wrap nf">
    <span class="eyebrow">Error 404</span>
    <h1>Esta página no existe</h1>
    <p>Puede que la dirección haya cambiado con la nueva web.</p>
    <div class="row"><a class="btn btn-primary" href="/">Volver al inicio</a><a class="btn btn-secondary" href="/servicios">Ver servicios</a></div>
  </section>
</BaseLayout>
<style>
  .nf { padding-block: 120px; display: grid; gap: 16px; }
  h1 { font-size: clamp(40px, 5vw, 72px); font-weight: 900; }
  p { color: var(--muted); }
  .row { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
