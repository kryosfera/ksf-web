---
interface Props { servicio?: string }
const { servicio } = Astro.props;
const href = servicio ? `/contacto?servicio=${servicio}` : '/contacto';
---
<section class="cta-final" data-mode="oscuro" aria-labelledby="cta-h">
  <div class="wrap inner">
    <span class="eyebrow">Hablemos</span>
    <h2 id="cta-h" data-split>¿Construimos juntos vuestra <span class="grad-text">próxima idea?</span></h2>
    <div class="row">
      <a class="btn btn-grad" href={href} data-magnetic>Pide una propuesta</a>
      <a class="btn btn-secondary" href="mailto:info@ksf.es">info@ksf.es</a>
    </div>
  </div>
</section>
<style>
  .cta-final { padding-block: 110px; border-top: 1px solid var(--line); }
  .inner { display: grid; gap: 18px; }
  h2 { font-size: clamp(38px, 5.4vw, 80px); max-width: 14ch; }
  .row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
</style>
