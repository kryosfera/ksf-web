---
import KLogo from './KLogo.astro';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const links = [
  { href: '/servicios', label: 'Servicios' }, { href: '/plataformas', label: 'Plataformas' },
  { href: '/nosotros', label: 'Nosotros' }, { href: '/contacto', label: 'Contacto' },
];
const path = Astro.url.pathname;
---
<header class:list={['site-header', { overlay }]}>
  <a class="brand" href="/" aria-label="KSF Digital Healthcare, inicio">
    <KLogo size={34} id="hdr" />
    <span><b>KSF</b><small>Digital Healthcare</small></span>
  </a>
  <nav aria-label="Principal" class="desk">
    {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
    <a class="btn btn-grad cta" href="/contacto" data-magnetic>Pide propuesta</a>
  </nav>
  <details class="mob">
    <summary aria-label="Abrir menú">Menú</summary>
    <nav aria-label="Principal móvil">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="btn btn-grad" href="/contacto">Pide propuesta</a>
    </nav>
  </details>
</header>
<style>
  .site-header { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px var(--gutter); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .site-header.overlay { position: absolute; left: 0; right: 0; top: 0; background: transparent; backdrop-filter: none; border-bottom: 0; color: #EEF5F6; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .brand b { display: block; font: 900 20px/1 var(--f-display); letter-spacing: .02em; }
  .brand small { display: block; font: 500 10.5px/1.3 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; opacity: .75; }
  .desk { display: flex; align-items: center; gap: clamp(14px, 2.2vw, 30px); font: 600 15px/1 var(--f-body); }
  .desk > a:not(.btn) { text-decoration: none; opacity: .85; }
  .desk > a[aria-current="page"], .desk > a:hover { opacity: 1; }
  .desk .cta { padding: 11px 18px; }
  .mob { display: none; position: relative; }
  .mob summary { list-style: none; cursor: pointer; font: 600 15px/1 var(--f-body); padding: 10px 14px; border: 1.5px solid var(--line); border-radius: 999px; }
  .mob summary::-webkit-details-marker { display: none; }
  .mob nav { position: absolute; right: 0; top: calc(100% + 8px); display: grid; gap: 14px; min-width: 220px; padding: 18px; background: var(--card); color: var(--fg); border: 1px solid var(--line); border-radius: 14px; }
  .mob nav a:not(.btn) { text-decoration: none; font-weight: 600; }
  @media (max-width: 900px) { .desk { display: none; } .mob { display: block; } }
</style>
